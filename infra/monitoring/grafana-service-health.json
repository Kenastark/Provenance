{
  "__plane": "infra",
  "__note": "Service-health dashboard (INFRA plane). Prometheus datasource, scraping the API /metrics. Kept deliberately separate from the model-drift dashboard.",
  "title": "Provenance — Service Health (infra)",
  "uid": "prov-service-health",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["provenance", "infra"],
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Service up",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "prov_up", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate (req/s) by path",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum by (path) (rate(prov_http_requests_total[1m]))", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx error rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "sum(rate(prov_http_requests_total{status=~\"5..\"}[1m]))", "refId": "A"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latency (s)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(prov_http_request_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "In-flight requests",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "prov_http_requests_in_flight", "refId": "A"}]
    }
  ]
}
