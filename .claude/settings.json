{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",

    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git stash*)",

      "Bash(gh pr view*)",
      "Bash(gh pr status*)",
      "Bash(gh pr list*)",
      "Bash(gh run*)",
      "Bash(gh issue*)",
      "Bash(gh repo view*)",

      "Bash(make*)",
      "Bash(uv*)",
      "Bash(pnpm*)",
      "Bash(prov*)",
      "Bash(pytest*)",
      "Bash(ruff*)",
      "Bash(mypy*)",
      "Bash(.venv/bin/*)"
    ],

    "ask": [
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh api*)",
      "Bash(gh repo edit*)",
      "Bash(gh label*)",
      "Bash(gh secret*)"
    ],

    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)"
    ]
  }
}
