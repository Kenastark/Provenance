# ---- data: never committed. See data/README.md ----
data/raw/**
data/interim/**
data/processed/**
data/manifests/*.json
!data/**/.gitkeep
!data/README.md

# ---- generated output ----
reports/*
!reports/.gitkeep

# ---- model artefacts ----
*.pt
*.pth
*.pkl
*.joblib
src/provenance/models/artefacts/**

# ---- python ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# ---- node ----
node_modules/
apps/web/dist/
apps/web/.vite/
apps/web/coverage/
apps/web/playwright-report/
apps/web/test-results/

# ---- env & local ----
.env
.env.local
*.local

# ---- os / editors ----
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json


# ---- claude code ----
# settings.json is committed - it is project policy (see CLAUDE.md).
# settings.local.json is per-machine (accumulated "don't ask again" approvals)
# and must never be committed, since it can silently widen what auto-approves
# on someone else's clone.
.claude/settings.local.json

# TypeScript incremental build artefact
apps/web/*.tsbuildinfo
