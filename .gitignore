# ---- data: never committed. See data/README.md ----
data/raw/**
data/interim/**
data/processed/**
data/manifests/*.json
!data/**/.gitkeep
!data/README.md

# ---- generated output ----
reports/*
!reports/.gitkeep

# The demo corpus is generated by `make demo-corpus` from the seeded generator.
# It is reproducible from the seed, so it is never committed.
.demo-corpus/
.demo-api.pid
.demo-api.log

# ---- model artefacts ----
*.pt
*.pth
*.pkl
*.joblib
src/provenance/models/artefacts/**
# Auto-generated ML model cards: reproducible from `prov models train`, filenames
# carry the training-data checksum, so committing them only churns. The hand-written
# cards (e.g. the propagation adjudicator) are tracked normally.
docs/model-cards/deweather-*.md
docs/model-cards/fault-*.md
# The HST-GAT's auto-generated card carries a checksum suffix (hst-gat-v1-<checksum>.md);
# the hand-written, committed card is docs/model-cards/hst-gat-v1.md, which this does NOT
# match.
docs/model-cards/hst-gat-v1-*.md
docs/model-cards/gcn-*.md
# Same story, one auto-generated card per trained parameter (imputation-<PARAMETER>-v1-<checksum>.md).
docs/model-cards/imputation-*.md

# ---- python ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# ---- basemap (fetched by scripts/fetch-basemap.sh; large, never committed) ----
apps/web/public/basemap/
.cache/pmtiles/

# ---- basemap glyph fonts (fetched by scripts/fetch-fonts.sh, ADR 0011) ----
apps/web/public/fonts/

# ---- node ----
node_modules/
apps/web/dist/
apps/web/.vite/
apps/web/coverage/
apps/web/playwright-report/
apps/web/test-results/
# Visual regression *baselines* are committed - they are the reference. Only the
# diff output of a failing run is not.
apps/web/e2e/**/*-actual.png
apps/web/e2e/**/*-diff.png
# Generated by e2e/global-setup.ts on every run - a role pre-seeded into
# localStorage, not a secret and not worth committing.
apps/web/e2e/.auth/
apps/web/*.tsbuildinfo

# ---- env & local ----
.env
.env.local
*.local

# ---- os / editors ----
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json


# ---- claude code ----
# settings.json is committed - it is project policy (see CLAUDE.md).
# settings.local.json is per-machine (accumulated "don't ask again" approvals)
# and must never be committed, since it can silently widen what auto-approves
# on someone else's clone.
.claude/settings.local.json

# TypeScript incremental build artefact
apps/web/*.tsbuildinfo
