# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- database ---
POSTGRES_USER=provenance
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=provenance
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://provenance:change_me_locally@localhost:5432/provenance

# --- api ---
PROVENANCE_ENV=local
PROVENANCE_LOG_LEVEL=INFO
PROVENANCE_API_HOST=0.0.0.0
PROVENANCE_API_PORT=8000

# --- data locations ---
PROVENANCE_DATA_RAW=./data/raw
PROVENANCE_REPORTS_DIR=./reports

# --- optional, phase 7 ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
